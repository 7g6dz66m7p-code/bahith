{
  "name": "bahith",
  "version": "0.0.0",
  "private": true,
  "description": "باحث | BAHITH — منصة بحث أكاديمي عربية أولاً",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "eval": "pnpm --filter @bahith/eval run eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @bahith/db run migrate",
    "db:rollback": "pnpm --filter @bahith/db run rollback",
    "db:seed": "pnpm --filter @bahith/db run seed",
    "secrets:scan": "gitleaks git --redact --no-banner",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": "prettier --write"
  }
}
