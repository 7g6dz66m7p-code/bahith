# BAHITH environment variables — names only, no values (engineering rule 4).
#
# Local development:  run `pnpm bootstrap`. It creates .env from this list, fills the
# non-secret local defaults and generates random local passwords. .env is never tracked.
# Any other environment: the project owner provides the real values out of band.

# --- PostgreSQL (docker-compose service "postgres") ---------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Owner/admin connection: migrations and seeds only. Never used by the running app.
DATABASE_ADMIN_URL=
# Application role "bahith_app" (no BYPASSRLS). `pnpm db:migrate` sets this password on the role.
DATABASE_URL=

# --- Redis (BullMQ) -----------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=
REDIS_URL=

# --- S3-compatible object storage (MinIO locally, R2/S3 in the cloud) ---------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
MINIO_PORT=
MINIO_CONSOLE_PORT=

# --- AI providers (used from Phase 3). Model names live here, never in code ----------
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_RERANK_MODEL=
