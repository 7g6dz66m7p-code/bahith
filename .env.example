# BAHITH environment variables — names only, no values (engineering rule 4).
#
# Local development:  run `pnpm bootstrap`. It creates .env from this list, fills the
# non-secret local defaults and generates random local passwords. .env is never tracked.
# Any other environment: the project owner provides the real values out of band.

# --- PostgreSQL (docker-compose service "postgres") ---------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Owner/admin connection: migrations and seeds only. Never used by the running app.
DATABASE_ADMIN_URL=
# Application role "bahith_app" (no BYPASSRLS). `pnpm db:migrate` sets this password on the role.
DATABASE_URL=
# Private identity role; never share this connection with research services.
AUTH_DATABASE_URL=

# --- Better Auth and email delivery ------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_HTTP_PORT=

# --- Redis (BullMQ) -----------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=
REDIS_URL=

# --- S3-compatible object storage (MinIO locally, R2/S3 in the cloud) ---------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
MINIO_PORT=
MINIO_CONSOLE_PORT=

# --- AI providers. Model names live here, never in code ------------------------------
# Format provider:model (providers: anthropic, openai). No default: the assistant reports
# "not configured" until AI_CHAT_MODEL and that provider's key are set. Passages are only
# sent after a project owner/editor consents in the project page.
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_RERANK_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Scholarly metadata services (packages/scholarly) -------------------------------
# Contact address sent to Crossref (polite pool `mailto`), OpenAlex and Unpaywall, which ask
# for one; those clients refuse to call without it. Use a project mailbox, never a personal one.
SCHOLARLY_CONTACT_EMAIL=
# Optional keys. OpenAlex heavily throttles anonymous search (free key: openalex.org/settings/api);
# Semantic Scholar and NCBI keys raise their shared anonymous limits.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# --- Platform administration and payments -------------------------------------------
# Verified emails (comma-separated) that may open /admin — they must also enable 2FA.
# Empty = nobody is a platform administrator.
PLATFORM_ADMIN_EMAILS=
# Payments stay disabled until the owner configures a provider AND sets this to "yes".
PAYMENTS_PROVIDER=
PAYMENTS_LIVE_AUTHORIZED=
