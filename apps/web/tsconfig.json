{
  "extends": "@bahith/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "test",
    "e2e",
    "load",
    "visual",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "*.ts",
    "*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
